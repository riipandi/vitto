{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "sortPackageJson": true,
    "sortImports": true,
    "overrides": [
        {
            "files": ["*.css", "*.scss", "*.less"],
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": ["*.json", "*.jsonc", "*.prettierrc", "*.plist"],
            "options": {
                "tabWidth": 4,
                "trailingComma": "none"
            }
        }
    ]
}
