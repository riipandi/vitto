{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Home') }}

<div class="text-center py-8 px-4 w-full">
  <div class="flex justify-center gap-8 mb-8 animate-[fadeIn_0.6s_ease-in]">
    <img src="/vite.svg" alt="Vite logo" class="w-20 h-20 transition-transform duration-300 hover:scale-110 hover:rotate-[5deg]">
    <img src="/favicon.svg" alt="Vento logo" class="w-20 h-20 transition-transform duration-300 hover:scale-110 hover:rotate-[5deg]">
  </div>

  <div class="max-w-[600px] mx-auto">
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">Welcome to Vitto</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">A minimal static site generator built with Vite and Vento.</p>

    <div class="flex flex-col gap-6 mt-8">
      <div class="flex items-start gap-4 text-left py-3 px-4 rounded-lg bg-gray-100 dark:bg-gray-800/50 transition-all duration-300 hover:bg-gray-200 dark:hover:bg-gray-800 hover:translate-x-1">
        <span class="flex items-center justify-center w-8 h-8 bg-blue-600 dark:bg-blue-500 text-white rounded-full font-bold text-base shrink-0">1</span>
        <p class="m-0 text-gray-700 dark:text-gray-300 leading-relaxed">
          Edit <code class="bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded text-sm text-blue-600 dark:text-blue-400">src/pages/index.vto</code> to get started
        </p>
      </div>

      <div class="flex items-start gap-4 text-left py-3 px-4 rounded-lg bg-gray-100 dark:bg-gray-800/50 transition-all duration-300 hover:bg-gray-200 dark:hover:bg-gray-800 hover:translate-x-1">
        <span class="flex items-center justify-center w-8 h-8 bg-blue-600 dark:bg-blue-500 text-white rounded-full font-bold text-base shrink-0">2</span>
        <p class="m-0 text-gray-700 dark:text-gray-300 leading-relaxed">Save and see your changes instantly</p>
      </div>
    </div>
  </div>
</div>
