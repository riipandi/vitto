<header class="border-b border-gray-200 dark:border-gray-800 py-4 shrink-0 bg-white dark:bg-gray-900">
  <div class="container max-w-screen-xl mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <a href="/" class="text-xl font-semibold text-gray-900 dark:text-white no-underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        {{ metadata.siteName }}
      </a>
      <nav class="flex gap-6 md:gap-6">
        <a href="/" class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 no-underline text-sm transition-colors {{ currentPath === '/' ? 'text-blue-600 dark:text-blue-400 font-medium' : '' }}">
          Home
        </a>
        <a href="/about" class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 no-underline text-sm transition-colors {{ currentPath === '/about' ? 'text-blue-600 dark:text-blue-400 font-medium' : '' }}">
          About
        </a>
        <a href="/not-found" class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 no-underline text-sm transition-colors">
          Not Found
        </a>
      </nav>
    </div>
  </div>
</header>
