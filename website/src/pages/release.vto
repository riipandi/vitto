{{ layout "layouts/site.vto" }}

{{ setMetadata('title', release ? release.title : 'Release Not Found') }}
{{ setMetadata('description', release ? release.description : '') }}

<div class="w-full max-w-7xl mx-auto px-5 sm:px-8 grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] grow">
  <!-- Sidebar — desktop -->
  <aside class="hidden lg:block pt-10 pb-8 border-r border-sand-200/60 dark:border-sand-800/60">
    <div class="sticky top-24 overflow-y-auto max-h-[calc(100vh-8rem)] pr-4 space-y-1">
      <h4 class="text-xs font-semibold uppercase tracking-wider text-sand-400 dark:text-sand-500 mb-3 px-3">
        Versions
      </h4>
      {{ if release.all && release.all.length > 0 }}
        {{ for entry of release.all }}
          <a href="/changelog/{{ entry.slug }}"
            class="flex items-center justify-between px-3 py-1.5 rounded-lg text-sm transition-colors
              {{ if entry.slug == release.slug }}
                text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 font-medium
              {{ else }}
                text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white hover:bg-sand-100 dark:hover:bg-sand-800
              {{ /if }}">
            <span class="text-xs {{ if entry.slug == release.slug }}text-amber-500/70 dark:text-amber-400/70{{ else }}text-sand-400 dark:text-sand-500{{ /if }}">{{ entry.date }}</span>
            <span class="font-mono">v{{ entry.version }}</span>
          </a>
        {{ /for }}
      {{ /if }}
      <hr class="my-4 border-sand-200/60 dark:border-sand-800/60" />
      <a href="/changelog"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm text-sand-500 dark:text-sand-400 hover:text-sand-700 dark:hover:text-sand-200 hover:bg-sand-100 dark:hover:bg-sand-800 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        All releases
      </a>
    </div>
  </aside>

  <!-- Content -->
  <div class="min-w-0 py-10 md:py-12 xl:px-10">
    {{ if release }}
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-sand-400 dark:text-sand-500 mb-8">
        <a href="/changelog" class="hover:text-sand-600 dark:hover:text-sand-300 transition-colors">Changelog</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-sand-600 dark:text-sand-300">v{{ release.version }}</span>
      </nav>

      <article>
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-sand-900 dark:text-white mb-1">{{ release.title }}</h1>
        <div class="flex items-center gap-2 text-sm text-sand-400 dark:text-sand-500 mb-6">
          {{ if release.date }}
            <time datetime="{{ release.date }}">{{ release.date }}</time>
          {{ /if }}
          <span aria-hidden="true" class="text-sand-300 dark:text-sand-600">·</span>
          <span class="font-mono">v{{ release.version }}</span>
        </div>
        {{ if release.description }}
          <p class="text-base text-sand-500 dark:text-sand-400 mb-6 leading-relaxed">{{ release.description }}</p>
        {{ /if }}
        <div class="prose prose-lg max-w-none">
          {{ release.content |> safe }}
        </div>
      </article>

      <!-- Navigation: prev / next -->
      <nav class="mt-16 pt-8 border-t border-sand-200/60 dark:border-sand-700/40">
        <div class="flex items-center justify-between gap-4">
          {{ if release.next }}
            <a href="/changelog/{{ release.next.slug }}"
              class="group flex flex-col items-start gap-0.5 min-w-0 flex-1">
              <span class="text-xs font-medium tracking-wider text-sand-400 dark:text-sand-500">Next release</span>
              <span class="text-sm font-semibold text-sand-700 dark:text-sand-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate max-w-full">
                v{{ release.next.version }}
              </span>
            </a>
          {{ else }}
            <div></div>
          {{ /if }}
          {{ if release.prev }}
            <a href="/changelog/{{ release.prev.slug }}"
              class="group flex flex-col items-end gap-0.5 min-w-0 flex-1 text-right">
              <span class="text-xs font-medium tracking-wider text-sand-400 dark:text-sand-500">Previous release</span>
              <span class="text-sm font-semibold text-sand-700 dark:text-sand-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate max-w-full">
                v{{ release.prev.version }}
              </span>
            </a>
          {{ else }}
            <div></div>
          {{ /if }}
        </div>
      </nav>
    {{ else }}
      <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div class="w-16 h-16 rounded-2xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-sand-400 dark:text-sand-500"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
        </div>
        <h1 class="text-3xl font-bold text-sand-900 dark:text-white mb-3">Release not found</h1>
        <p class="text-sand-500 dark:text-sand-400 mb-8 max-w-md">The changelog entry you're looking for doesn't exist or has been moved.</p>
        <a href="/changelog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-medium text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
          Browse all releases
        </a>
      </div>
    {{ /if }}
  </div>
</div>

<!-- Sidebar — mobile -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-sand-50/95 dark:bg-sand-900/95 backdrop-blur-xl border-t border-sand-200/60 dark:border-sand-800/60 p-4">
  <details class="group">
    <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-sand-700 dark:text-sand-300">
      Jump to version
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="mt-3 space-y-1 max-h-[50vh] overflow-y-auto">
      {{ if release.all && release.all.length > 0 }}
        {{ for entry of release.all }}
          <a href="/changelog/{{ entry.slug }}"
            class="block px-3 py-2 rounded-lg text-sm transition-colors
              {{ if entry.slug == release.slug }}
                text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 font-medium
              {{ else }}
                text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white hover:bg-sand-100 dark:hover:bg-sand-800
              {{ /if }}">
            <span class="text-xs {{ if entry.slug == release.slug }}text-amber-500/70 dark:text-amber-400/70{{ else }}text-sand-400 dark:text-sand-500{{ /if }}">{{ entry.date }}</span>
            <span class="font-medium ml-2">v{{ entry.version }}</span>
          </a>
        {{ /for }}
      {{ /if }}
      <hr class="my-3 border-sand-200/60 dark:border-sand-800/60" />
      <a href="/changelog"
        class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm text-sand-500 dark:text-sand-400 hover:text-sand-700 dark:hover:text-sand-200 hover:bg-sand-100 dark:hover:bg-sand-800 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        All releases
      </a>
    </div>
  </details>
</div>
