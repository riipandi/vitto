{{ layout "layouts/base.vto" }}

{{ setMetadata('title', 'Page Not Found') }}

<div class="min-h-screen flex items-center justify-center bg-sand-50 dark:bg-sand-900 px-5">
  <div class="max-w-lg w-full text-center">
    <div class="mb-8">
      <div class="w-20 h-20 rounded-3xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mx-auto mb-6">
        <span class="text-4xl font-bold text-sand-300 dark:text-sand-600">404</span>
      </div>
      <h1 class="text-3xl font-bold text-sand-900 dark:text-white mb-3">Page Not Found</h1>
      <p class="text-sand-500 dark:text-sand-400">
        The page you're looking for doesn't exist or has been moved.
      </p>
    </div>

    {{ if !isDev }}
    <div class="mb-8">
      <p class="text-sm text-sand-400 dark:text-sand-500 mb-3">Try searching:</p>
      <div id="search" class="text-left"></div>
    </div>
    {{ /if }}

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
      <a href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-medium text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
        Go Home
      </a>
      <button onclick="window.history.back()"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-sand-100 dark:bg-sand-800 text-sand-700 dark:text-sand-300 font-medium text-sm hover:bg-sand-200 dark:hover:bg-sand-700 transition-colors">
        Go Back
      </button>
    </div>

    <div class="flex flex-wrap justify-center gap-5 text-sm">
      <a href="/docs" class="text-sand-400 dark:text-sand-500 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Docs</a>
      <a href="/blog" class="text-sand-400 dark:text-sand-500 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Blog</a>
      <a href="/about" class="text-sand-400 dark:text-sand-500 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">About</a>
    </div>
  </div>
</div>
