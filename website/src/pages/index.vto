{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Fast Static Sites with Vite & Vento') }}
{{ setMetadata('description', 'A minimal static site generator built with Vite and the Vento templating engine. Fast, flexible, and minimal config.') }}

<!-- Hero -->
<section class="relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50 to-sand-100/50 dark:from-sand-900 dark:to-sand-900"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-to-b from-amber-200/20 via-violet-200/10 to-transparent dark:from-amber-500/10 dark:via-violet-500/5 dark:to-transparent rounded-full blur-3xl"></div>
    <!-- Dot pattern -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"></div>
  </div>

  <div class="max-w-4xl mx-auto px-5 sm:px-8 pt-24 pb-28 md:pt-36 md:pb-40 text-center">
    <!-- Badge -->
    <div class="slide-up inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-500/10 border border-amber-200/60 dark:border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-medium mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
      Powered by Vite v8
    </div>

    <!-- Headline -->
    <h1 class="slide-up-delay-1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-sand-900 dark:text-white leading-[1.08]">
      Static sites,
      <br>
      <span class="bg-gradient-to-r from-amber-500 via-amber-400 to-violet-500 bg-clip-text text-transparent">
        beautifully simple.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="slide-up-delay-2 mt-6 text-lg md:text-xl text-sand-500 dark:text-sand-400 max-w-xl mx-auto leading-relaxed">
      A minimal static site generator powered by Vite and Vento.
      Fast builds, minimal config, deploy anywhere.
    </p>

    <!-- CTA row: button + code snippet -->
    <div class="slide-up-delay-3 mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/docs/02-getting-started"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-semibold text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors shadow-lg shadow-sand-900/10 dark:shadow-white/10">
        Get Started
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
      <div class="inline-flex items-center gap-3 px-5 py-3 rounded-xl bg-sand-100 dark:bg-sand-800 text-sand-700 dark:text-sand-300 text-sm font-mono border border-sand-200/60 dark:border-sand-700/60">
        <span>npm create vitto@latest</span>
        <i data-lucide="copy" class="w-3.5 h-3.5 text-sand-400 dark:text-sand-500 cursor-pointer hover:text-amber-500 transition-colors" onclick="copyCommand(this, 'npm create vitto@latest')"></i>
      </div>
    </div>

    <!-- Deploy -->
    <div class="slide-up-delay-3 mt-6">
      <a href="https://deploy.workers.cloudflare.com/?url=https://github.com/riipandi/vitto/tree/main/starter"
        target="_blank" rel="noopener noreferrer">
        <img src="https://deploy.workers.cloudflare.com/button" class="h-10 w-auto mx-auto opacity-80 hover:opacity-100 transition-opacity" alt="Deploy to Cloudflare Workers">
      </a>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-3">Features</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-sand-900 dark:text-white">
        Everything you need, nothing you don't.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Feature 1 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="zap" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Lightning Fast</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Powered by Vite's HMR and optimized build pipeline. Edit, save, see instantly.</p>
      </div>

      <!-- Feature 2 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-violet-100 dark:bg-violet-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="file-text" class="w-5 h-5 text-violet-600 dark:text-violet-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Vento Templates</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Simple, expressive templating with Vento. Partials, layouts, and data injection.</p>
      </div>

      <!-- Feature 3 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="search" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Built-in Search</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Integrated Pagefind for fast, static search. Zero server required.</p>
      </div>

      <!-- Feature 4 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-violet-100 dark:bg-violet-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="route" class="w-5 h-5 text-violet-600 dark:text-violet-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Dynamic Routes</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Generate pages from any data source. CMS, APIs, markdown, or local files.</p>
      </div>

      <!-- Feature 5 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="puzzle" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Vite Ecosystem</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Full access to Vite plugins. Tailwind, UnoCSS, PostCSS, and more.</p>
      </div>

      <!-- Feature 6 -->
      <div class="reveal group p-6 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all hover:shadow-lg hover:shadow-amber-500/5">
        <div class="w-10 h-10 rounded-xl bg-violet-100 dark:bg-violet-500/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <i data-lucide="package" class="w-5 h-5 text-violet-600 dark:text-violet-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-sand-900 dark:text-white mb-2">Minimal Config</h3>
        <p class="text-sm text-sand-500 dark:text-sand-400 leading-relaxed">Works out of the box. Sensible defaults that just work. Customize when you need to.</p>
      </div>
    </div>
  </div>
</section>

<!-- Code Example -->
<section class="py-20 md:py-28 bg-sand-100/50 dark:bg-sand-800/30">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-3">Quick Start</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-sand-900 dark:text-white">
        Up and running in seconds.
      </h2>
    </div>

    <div class="reveal grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Install -->
      <div class="rounded-2xl bg-white dark:bg-sand-800/80 border border-sand-200/60 dark:border-sand-700/40 p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-xs text-sand-400 dark:text-sand-500 font-mono">terminal</span>
        </div>
        <pre class="text-sm font-mono text-sand-700 dark:text-sand-300 leading-relaxed overflow-x-auto"><code><span class="text-sand-400 dark:text-sand-500"># Create a new project</span>
<span class="text-amber-600 dark:text-amber-400">npm</span> create vitto@latest my-site

<span class="text-sand-400 dark:text-sand-500"># Start dev server</span>
<span class="text-amber-600 dark:text-amber-400">cd</span> my-site
<span class="text-amber-600 dark:text-amber-400">npm</span> run dev</code></pre>
      </div>

      <!-- Config -->
      <div class="rounded-2xl bg-white dark:bg-sand-800/80 border border-sand-200/60 dark:border-sand-700/40 p-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-xs text-sand-400 dark:text-sand-500 font-mono">vite.config.ts</span>
        </div>
        <pre class="text-sm font-mono text-sand-700 dark:text-sand-300 leading-relaxed overflow-x-auto"><code><span class="text-violet-600 dark:text-violet-400">import</span> { defineConfig } <span class="text-violet-600 dark:text-violet-400">from</span> <span class="text-amber-600 dark:text-amber-400">'vite'</span>
<span class="text-violet-600 dark:text-violet-400">import</span> vitto <span class="text-violet-600 dark:text-violet-400">from</span> <span class="text-amber-600 dark:text-amber-400">'vitto'</span>

<span class="text-violet-600 dark:text-violet-400">export default</span> defineConfig({
  plugins: [
    vitto({
      metadata: {
        siteName: <span class="text-amber-600 dark:text-amber-400">'My Site'</span>,
      },
    }),
  ],
})</code></pre>
      </div>
    </div>
  </div>
</section>

<!-- Templates -->
<section class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-3">Templates</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-sand-900 dark:text-white">
        Start with the right foundation.
      </h2>
      <p class="mt-4 text-sand-500 dark:text-sand-400 max-w-xl mx-auto">
        Choose from pre-built templates or start from scratch.
      </p>
    </div>

    <div class="reveal grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="group p-5 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all">
        <div class="flex items-center justify-between mb-3">
          <h4 class="font-semibold text-sand-900 dark:text-white">Basic</h4>
          <code class="text-xs font-mono text-sand-400 dark:text-sand-500 bg-sand-100 dark:bg-sand-800 px-2 py-1 rounded-md">--template basic</code>
        </div>
        <p class="text-sm text-sand-500 dark:text-sand-400">Minimal Vitto setup. Clean slate, maximum flexibility.</p>
      </div>

      <div class="group p-5 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all">
        <div class="flex items-center justify-between mb-3">
          <h4 class="font-semibold text-sand-900 dark:text-white">Tailwind CSS</h4>
          <code class="text-xs font-mono text-sand-400 dark:text-sand-500 bg-sand-100 dark:bg-sand-800 px-2 py-1 rounded-md">--template tailwindcss</code>
        </div>
        <p class="text-sm text-sand-500 dark:text-sand-400">Tailwind CSS pre-configured. Utility-first styling ready to go.</p>
      </div>

      <div class="group p-5 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all">
        <div class="flex items-center justify-between mb-3">
          <h4 class="font-semibold text-sand-900 dark:text-white">Alpine.js</h4>
          <code class="text-xs font-mono text-sand-400 dark:text-sand-500 bg-sand-100 dark:bg-sand-800 px-2 py-1 rounded-md">--template alpinejs</code>
        </div>
        <p class="text-sm text-sand-500 dark:text-sand-400">Alpine.js integration. Interactive components without the bloat.</p>
      </div>

      <div class="group p-5 rounded-2xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-amber-300/60 dark:hover:border-amber-500/30 transition-all">
        <div class="flex items-center justify-between mb-3">
          <h4 class="font-semibold text-sand-900 dark:text-white">htmx</h4>
          <code class="text-xs font-mono text-sand-400 dark:text-sand-500 bg-sand-100 dark:bg-sand-800 px-2 py-1 rounded-md">--template htmx</code>
        </div>
        <p class="text-sm text-sand-500 dark:text-sand-400">htmx integration. Hypermedia-driven interactions made easy.</p>
      </div>
    </div>
  </div>
</section>
<!-- CTA -->
<section class="py-20 md:py-28">
  <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <div class="reveal relative p-10 md:p-14 rounded-3xl bg-gradient-to-br from-sand-900 to-sand-800 dark:from-sand-800 dark:to-sand-900 border border-sand-700/50 overflow-hidden">
      <!-- Glow -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-amber-500/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 translate-x-1/4 translate-y-1/4 w-48 h-48 bg-violet-500/10 rounded-full blur-3xl"></div>

      <div class="relative">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Ready to build something fast?</h2>
        <p class="text-sand-400 mb-8 max-w-md mx-auto">Start with Vitto and ship your next static site in minutes, not hours.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/docs/02-getting-started"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-sand-900 font-semibold text-sm transition-colors shadow-lg shadow-amber-500/25">
            Read the Docs
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </a>
          <a href="https://github.com/riipandi/vitto" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white font-medium text-sm transition-colors border border-white/10">
            <i data-lucide="github" class="w-4 h-4"></i>
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
