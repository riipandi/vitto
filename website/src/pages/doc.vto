{{ layout "layouts/docs.vto" }}

{{ setMetadata('title', doc ? doc.title : 'Doc Not Found') }}
{{ setMetadata('description', doc ? doc.description : '') }}

<div class="flex grow">
  {{ include "partials/docs-sidebar.vto" }}

  <div class="flex-1 min-w-0">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 py-12 md:py-16">
      {{ if doc }}
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-sand-400 dark:text-sand-500 mb-8">
          <a href="/docs" class="hover:text-sand-600 dark:hover:text-sand-300 transition-colors">Docs</a>
          <i data-lucide="chevron-right" class="w-3 h-3"></i>
          <span class="text-sand-600 dark:text-sand-300">{{ doc.title }}</span>
        </nav>

        <!-- Content -->
        <article class="prose prose-lg max-w-none">
          {{ doc.content |> safe }}
        </article>

        <!-- Nav -->
        <div class="mt-16 pt-8 border-t border-sand-200/60 dark:border-sand-700/40">
          <a href="/docs" class="inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 dark:text-amber-400 hover:underline">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to all docs
          </a>
        </div>
      {{ else }}
        <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
          <div class="w-16 h-16 rounded-2xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mb-6">
            <i data-lucide="file-question" class="w-8 h-8 text-sand-400 dark:text-sand-500"></i>
          </div>
          <h1 class="text-3xl font-bold text-sand-900 dark:text-white mb-3">Doc not found</h1>
          <p class="text-sand-500 dark:text-sand-400 mb-8 max-w-md">
            The documentation page you're looking for doesn't exist or has been moved.
          </p>
          <a href="/docs"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-medium text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
            Browse all docs
          </a>
        </div>
      {{ /if }}
    </div>
  </div>
</div>
