{{ layout "layouts/site.vto" }}

{{ setMetadata('title', post ? post.title : 'Post Not Found') }}

<div class="max-w-3xl mx-auto px-5 sm:px-8 py-12 md:py-20">
  {{ if post }}
    <nav class="flex items-center gap-2 text-sm text-sand-400 dark:text-sand-500 mb-8">
      <a href="/blog" class="hover:text-sand-600 dark:hover:text-sand-300 transition-colors">Blog</a>
      <i data-lucide="chevron-right" class="w-3 h-3"></i>
      <span class="text-sand-600 dark:text-sand-300 truncate">{{ post.title }}</span>
    </nav>

    <article>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-sand-900 dark:text-white mb-4">
        {{ post.title }}
      </h1>
      <p class="text-sm text-sand-400 dark:text-sand-500 mb-10">
        Post {{ post.id }}
      </p>

      <div class="prose prose-lg max-w-none">
        {{ post.body }}
      </div>
    </article>

    <div class="mt-16 pt-8 border-t border-sand-200/60 dark:border-sand-700/40">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 dark:text-amber-400 hover:underline">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Back to all posts
      </a>
    </div>
  {{ else }}
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
      <div class="w-16 h-16 rounded-2xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mb-6">
        <i data-lucide="file-question" class="w-8 h-8 text-sand-400 dark:text-sand-500"></i>
      </div>
      <h1 class="text-3xl font-bold text-sand-900 dark:text-white mb-3">Post not found</h1>
      <p class="text-sand-500 dark:text-sand-400 mb-8 max-w-md">
        The post you're looking for doesn't exist or has been moved.
      </p>
      <a href="/blog"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sand-900 dark:bg-white text-white dark:text-sand-900 font-medium text-sm hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
        Browse all posts
      </a>
    </div>
  {{ /if }}
</div>
