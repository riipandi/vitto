{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Blog') }}

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50 to-sand-100/50 dark:from-sand-900 dark:to-sand-900"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-gradient-to-b from-amber-200/15 via-transparent to-transparent dark:from-amber-500/8 dark:via-transparent dark:to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-3xl mx-auto px-5 sm:px-8 pt-20 pb-12 md:pt-28 md:pb-16 text-center">
    <h1 class="slide-up text-4xl md:text-5xl font-bold tracking-tight text-sand-900 dark:text-white mb-4">
      Blog
    </h1>
    <p class="slide-up-delay-1 text-lg text-sand-500 dark:text-sand-400">
      Updates, ideas, and stories from the Vitto project.
    </p>
  </div>
</section>

<!-- Posts -->
<section class="py-12 md:py-16">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    {{ if posts && posts.items && posts.items.length > 0 }}
      <div class="space-y-1">
        {{ for post of posts.items }}
          <a href="/blog/{{ post.slug }}"
            class="group block p-5 -mx-5 rounded-xl hover:bg-sand-100/80 dark:hover:bg-sand-800/50 transition-colors">
            <h2 class="text-xl font-semibold text-sand-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-2">
              {{ post.title }}
            </h2>
            <p class="text-sand-500 dark:text-sand-400 line-clamp-2 leading-relaxed mb-2">
              {{ post.body }}
            </p>
            <span class="text-sm font-medium text-amber-600 dark:text-amber-400 inline-flex items-center gap-1">
              Read more
              <i data-lucide="arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"></i>
            </span>
          </a>
        {{ /for }}
      </div>
    {{ else }}
      <div class="text-center py-20">
        <div class="w-14 h-14 rounded-2xl bg-sand-100 dark:bg-sand-800 flex items-center justify-center mx-auto mb-5">
          <i data-lucide="pen-line" class="w-7 h-7 text-sand-400 dark:text-sand-500"></i>
        </div>
        <p class="text-sand-500 dark:text-sand-400 text-lg">No posts available yet.</p>
      </div>
    {{ /if }}

    {{ if posts && posts.totalPages > 1 }}
      <nav class="flex items-center justify-center gap-3 mt-12 pt-8 border-t border-sand-200/60 dark:border-sand-700/40">
        {{ if posts.hasPrev }}
          <a href="{{ posts.prevUrl }}"
            class="px-4 py-2 text-sm font-medium text-sand-600 dark:text-sand-400 bg-white dark:bg-sand-800 border border-sand-200/60 dark:border-sand-700/40 rounded-xl hover:border-amber-300 dark:hover:border-amber-500/30 transition-colors">
            Previous
          </a>
        {{ /if }}

        <span class="text-sm text-sand-400 dark:text-sand-500">
          Page {{ posts.page }} of {{ posts.totalPages }}
        </span>

        {{ if posts.hasNext }}
          <a href="{{ posts.nextUrl }}"
            class="px-4 py-2 text-sm font-medium text-white bg-sand-900 dark:bg-white dark:text-sand-900 rounded-xl hover:bg-sand-800 dark:hover:bg-sand-100 transition-colors">
            Next
          </a>
        {{ /if }}
      </nav>
    {{ /if }}
  </div>
</section>
