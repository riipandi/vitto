          <li><a href="/docs/core/templating" class="text-sand-500 dark:text-sand-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Templating</a></li>
          <li><a href="/docs/features/deployment" class="text-sand-500 dark:text-sand-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Deployment</a></li>
        </ul>
