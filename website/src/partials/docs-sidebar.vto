        <li>
          <a href="/docs/06-hooks"
            class="{{currentPath === '/docs/06-hooks' ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 font-medium' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white hover:bg-sand-100 dark:hover:bg-sand-800'}} block px-3 py-1.5 rounded-lg text-sm transition-colors">
