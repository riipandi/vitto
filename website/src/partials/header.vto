<header class="sticky top-0 z-50 backdrop-blur-xl bg-sand-50/80 dark:bg-sand-900/80 border-b border-sand-200/60 dark:border-sand-800/60">
  <nav class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center shadow-sm group-hover:shadow-amber-400/25 transition-shadow">
            <span class="text-white font-bold text-sm">V</span>
          </div>
          <span class="text-lg font-bold tracking-tight text-sand-900 dark:text-white">
            Vitto
          </span>
        </a>
      </div>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/docs"
          class="{{currentPath?.startsWith('/docs') ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          Docs
        </a>
        <a href="/blog"
          class="{{currentPath?.startsWith('/blog') ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          Blog
        </a>
        <a href="/about"
          class="{{currentPath === '/about' ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          About
        </a>

        <div class="w-px h-5 bg-sand-200 dark:bg-sand-700 mx-2"></div>

        <!-- GitHub -->
        <a href="https://github.com/riipandi/vitto" target="_blank" rel="noopener noreferrer"
          class="text-sand-500 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white p-2 rounded-lg transition-colors"
          aria-label="GitHub">
          <img src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg" class="w-5 h-5 dark:invert" alt="GitHub">
        </a>

      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-2 md:hidden">
        <button id="mobile-menu-button" type="button"
          class="text-sand-500 hover:text-sand-700 dark:text-sand-400 dark:hover:text-sand-200 focus:outline-none p-2 rounded-lg"
          aria-label="Toggle menu" aria-expanded="false">
          <svg id="menu-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile overlay -->
<div id="mobile-menu-overlay" class="hidden fixed inset-0 bg-black/30 backdrop-blur-sm z-40 md:hidden" aria-hidden="true"></div>

<!-- Mobile menu -->
<div id="mobile-menu" class="hidden fixed top-16 left-0 right-0 bottom-0 z-50 md:hidden bg-sand-50/95 dark:bg-sand-900/95 backdrop-blur-xl">
  <div class="flex flex-col items-center justify-center h-full px-6">
    <nav class="space-y-2 w-full max-w-xs">
      <a href="/"
        class="{{currentPath === '/' ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800'}} block px-4 py-3 rounded-xl text-lg font-medium text-center transition-colors">
        Home
      </a>
      <a href="/docs"
        class="{{currentPath?.startsWith('/docs') ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800'}} block px-4 py-3 rounded-xl text-lg font-medium text-center transition-colors">
        Docs
      </a>
      <a href="/blog"
        class="{{currentPath?.startsWith('/blog') ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800'}} block px-4 py-3 rounded-xl text-lg font-medium text-center transition-colors">
        Blog
      </a>
      <a href="/about"
        class="{{currentPath === '/about' ? 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800'}} block px-4 py-3 rounded-xl text-lg font-medium text-center transition-colors">
        About
      </a>
      <div class="pt-4 flex justify-center">
        <a href="https://github.com/riipandi/vitto" target="_blank" rel="noopener noreferrer"
          class="text-sand-500 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white inline-flex items-center gap-2 text-sm">
          <img src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg" class="w-4 h-4 dark:invert" alt="GitHub">
          GitHub
        </a>
      </div>
    </nav>
  </div>
</div>
