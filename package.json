{
    "name": "vitto-repo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "start": "turbo run start --filter=website",
        "dev": "turbo run dev --filter=vitto --filter=website",
        "cleanup": "turbo cleanup --cache=local:rw && pnpm dlx rimraf pnpm-lock.yaml node_modules",
        "create-vitto": "turbo run dev --filter=create-vitto --log-prefix=none --no-daemon --",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "publish:dry": "turbo publish:dry --filter=vitto --filter=create-vitto",
        "publish:npm": "turbo publish:npm --filter=vitto --filter=create-vitto",
        "format": "oxfmt --write",
        "lint": "turbo lint --cache=local:rw,remote:r",
        "check": "turbo check --cache=local:rw,remote:r",
        "typecheck": "turbo typecheck --cache=local:rw,remote:r"
    },
    "devDependencies": {
        "npm-check-updates": "^22.2.9",
        "oxfmt": "0.60.0",
        "oxlint": "^1.75.0",
        "turbo": "^2.10.6"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.16.0"
}
