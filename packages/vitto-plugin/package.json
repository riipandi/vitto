{
    "name": "vitto",
    "version": "0.0.0",
    "type": "module",
    "description": "A minimal static site generator built with Vite and the Vento templating engine.",
    "author": "Aris Ripandi <aris@duck.com>",
    "license": "MIT",
    "homepage": "https://github.com/riipandi/vitto",
    "funding": "https://github.com/riipandi/vitto?sponsor=1",
    "repository": {
        "type": "git",
        "url": "https://github.com/riipandi/vitto",
        "directory": "packages/vitto-plugin"
    },
    "bugs": {
        "url": "https://github.com/riipandi/vitto/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsc && tsdown",
        "prepublishOnly": "NODE_ENV=production tsdown",
        "publish:dry": "NODE_ENV=production pnpm publish --no-git-checks --dry-run",
        "publish:npm": "NODE_ENV=production pnpm publish --no-git-checks",
        "cleanup": "pnpm dlx del-cli dist node_modules .turbo",
        "lint": "biome lint . --write",
        "check": "biome check . --write",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "vite": "^7.1.10"
    },
    "dependencies": {
        "@swc/html": "^1.15.46",
        "itty-chroma": "^1.0.6",
        "itty-time": "^2.0.2",
        "pagefind": "^1.5.2",
        "picospinner": "^3.0.0",
        "ufo": "^1.6.4",
        "ventojs": "^2.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.5",
        "@types/node": "^26.1.1",
        "tsdown": "^0.22.13",
        "typescript": "^7.0.2",
        "vite": "^8.1.5"
    },
    "files": [
        "dist/**/*",
        "!tests/**/*",
        "!dist/**/*.*.map",
        "!tests/**/*.*.map",
        "package.json",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "vite",
        "vento",
        "ssg",
        "hmr",
        "pagefind",
        "generator",
        "static",
        "website",
        "jamstack"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
