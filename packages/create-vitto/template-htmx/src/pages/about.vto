{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'About') }}

<div class="about-center">
  <div class="about-content">
    <h1>About This Template</h1>
    <p class="about-intro">This is a simple and modern template built with:</p>

    <div class="tech-stack">
      <div class="tech-item">
        <div class="tech-icon">⚡</div>
        <h3>Vite</h3>
        <p>Lightning fast build tool with instant HMR</p>
      </div>

      <div class="tech-item">
        <div class="tech-icon">🌬️</div>
        <h3>Vento</h3>
        <p>Minimal and powerful template engine</p>
      </div>

      <div class="tech-item">
        <div class="tech-icon">🚀</div>
        <h3>HTMX</h3>
        <p>High power tools for HTML - AJAX, WebSockets & more directly in HTML</p>
      </div>
    </div>
  </div>
</div>
