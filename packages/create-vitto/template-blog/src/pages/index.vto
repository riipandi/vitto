{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Home') }}

<div class="text-center py-8 px-4 w-full">
  <div class="flex justify-center gap-8 mb-8 animate-[fadeIn_0.6s_ease-in]">
    <img src="/vite.svg" alt="Vite logo" class="w-20 h-20 transition-transform duration-300 hover:scale-110 hover:rotate-[5deg]">
    <img src="/favicon.svg" alt="Vento logo" class="w-20 h-20 transition-transform duration-300 hover:scale-110 hover:rotate-[5deg]">
  </div>

  <div class="max-w-[600px] mx-auto">
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">Welcome to Vitto Blog</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">A blog template built with Vite, Vento, and Tailwind CSS featuring pagination.</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <a href="/blog" class="inline-block px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white rounded-lg font-medium transition-colors duration-300 hover:bg-blue-700 dark:hover:bg-blue-600 no-underline">
        Read the Blog
      </a>
      <a href="/about" class="inline-block px-6 py-3 bg-gray-200 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg font-medium transition-colors duration-300 hover:bg-gray-300 dark:hover:bg-gray-700 no-underline">
        About
      </a>
    </div>
  </div>
</div>
