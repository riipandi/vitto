{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Blog') }}

<div class="w-full max-w-[900px] mx-auto py-8 px-4">
  <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">Blog</h1>

  {{ if posts && posts.items && posts.items.length > 0 }}
    <div class="flex flex-col gap-4">
      {{ for post of posts.items }}
        <article class="p-6 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 transition-all duration-300 hover:bg-gray-50 dark:hover:bg-gray-700 hover:-translate-y-0.5 hover:shadow-lg">
          <a href="/blog/post-{{ post.id }}.html" class="no-underline">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {{ post.title }}
            </h2>
          </a>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-3 line-clamp-2">{{ post.body }}</p>
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-500 dark:text-gray-500">Post #{{ post.id }}</span>
            <a href="/blog/post-{{ post.id }}.html" class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 no-underline font-medium transition-colors">
              Read more &rarr;
            </a>
          </div>
        </article>
      {{ /for }}
    </div>

    <nav class="flex items-center justify-between mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
      <div>
        {{ if posts.hasPrev }}
          <a href="{{ posts.prevUrl }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors no-underline">
            &larr; Previous
          </a>
        {{ else }}
          <span class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-400 dark:text-gray-600 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg cursor-not-allowed">
            &larr; Previous
          </span>
        {{ /if }}
      </div>

      <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
        <span>Page</span>
        <span class="font-semibold text-gray-900 dark:text-white">{{ posts.page }}</span>
        <span>of</span>
        <span class="font-semibold text-gray-900 dark:text-white">{{ posts.totalPages }}</span>
      </div>

      <div>
        {{ if posts.hasNext }}
          <a href="{{ posts.nextUrl }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors no-underline">
            Next &rarr;
          </a>
        {{ else }}
          <span class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-400 dark:text-gray-600 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg cursor-not-allowed">
            Next &rarr;
          </span>
        {{ /if }}
      </div>
    </nav>
  {{ else }}
    <div class="text-center py-16">
      <p class="text-gray-600 dark:text-gray-400 text-lg">No posts available yet.</p>
    </div>
  {{ /if }}
</div>
