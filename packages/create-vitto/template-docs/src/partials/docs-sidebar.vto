<aside class="hidden lg:block w-56 shrink-0">
  <nav class="sticky top-20 space-y-6">
    {{ if doc.sections }}
      {{ for section of doc.sections }}
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">{{ section.label }}</h4>
          <ul class="space-y-1">
            {{ for item of section.items }}
              <li>
                <a href="/docs/{{ item.slug }}" class="block text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white no-underline transition-colors {{ doc.slug === item.slug ? 'text-blue-600 dark:text-blue-400 font-medium' : '' }}">{{ item.title }}</a>
              </li>
            {{ /for }}
          </ul>
        </div>
      {{ /for }}
    {{ /if }}
  </nav>
</aside>
