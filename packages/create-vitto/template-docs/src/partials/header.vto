<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur border-b border-gray-200 dark:border-gray-800">
  <nav class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/" class="font-semibold text-gray-900 dark:text-white no-underline">{{ metadata.siteName }}</a>
    <div class="flex items-center gap-4 text-sm">
      <a href="/blog" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white no-underline transition-colors">Blog</a>
      <a href="/docs" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white no-underline transition-colors">Docs</a>
      <pagefind-modal-trigger compact hide-shortcut class="search-trigger" aria-label="Search"></pagefind-modal-trigger>
    </div>
  </nav>
</header>
