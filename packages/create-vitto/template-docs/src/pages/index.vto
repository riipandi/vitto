{{ layout "layouts/site.vto" }}
{{ setMetadata('title', 'Home') }}
<div class="text-center py-16 px-4 max-w-2xl mx-auto">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">{{ metadata.siteName }}</h1>
  <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">A documentation site built with Vitto.</p>
  <a href="/docs" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors no-underline">Browse Docs</a>
</div>
