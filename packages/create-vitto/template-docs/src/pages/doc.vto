{{ layout "layouts/site.vto" }}
{{ setMetadata('title', doc ? doc.title : 'Doc Not Found') }}

<div class="max-w-6xl mx-auto px-4 py-12">
  {{ if doc }}
    <div class="flex gap-8">
      {{ include "partials/docs-sidebar.vto" }}
      <main class="flex-1 min-w-0">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">{{ doc.title }}</h1>
        {{ if doc.description }}
          <p class="text-gray-600 dark:text-gray-400 mb-8 text-lg">{{ doc.description }}</p>
        {{ /if }}
        <div class="prose prose-gray dark:prose-invert max-w-none">{{ doc.content |> safe }}</div>
        <nav class="flex justify-between mt-12 pt-6 border-t border-gray-200 dark:border-gray-700">
          {{ if doc.prev }}
            <a href="/docs/{{ doc.prev.slug }}" class="text-blue-600 dark:text-blue-400 hover:underline no-underline">&larr; {{ doc.prev.title }}</a>
          {{ else }}
            <span></span>
          {{ /if }}
          {{ if doc.next }}
            <a href="/docs/{{ doc.next.slug }}" class="text-blue-600 dark:text-blue-400 hover:underline no-underline">{{ doc.next.title }} &rarr;</a>
          {{ else }}
            <span></span>
          {{ /if }}
        </nav>
      </main>
    </div>
  {{ else }}
    <div class="text-center py-16">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Page not found</h1>
      <p class="text-gray-500 mb-6">The documentation page you're looking for doesn't exist.</p>
      <a href="/docs" class="text-blue-600 dark:text-blue-400 hover:underline">Browse all docs</a>
    </div>
  {{ /if }}
</div>
