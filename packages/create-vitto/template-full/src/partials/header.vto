<header class="sticky top-0 z-50 backdrop-blur-xl bg-sand-50/80 dark:bg-sand-900/80 border-b border-sand-200/60 dark:border-sand-800/60">
  <nav class="max-w-7xl w-full mx-auto px-5 sm:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center shadow-sm group-hover:shadow-emerald-400/25 transition-shadow">
            <span class="text-white font-bold text-sm">V</span>
          </div>
          <span class="text-lg font-bold tracking-tight text-sand-900 dark:text-white">
            Starter
          </span>
        </a>
      </div>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/blog"
          class="{{currentPath?.startsWith('/blog') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          Blog
        </a>
        <a href="/docs"
          class="{{currentPath?.startsWith('/docs') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          Docs
        </a>
        <a href="/changelog"
          class="{{currentPath?.startsWith('/changelog') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          Changelog
        </a>
        <a href="/about"
          class="{{currentPath === '/about' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10' : 'text-sand-600 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white'}} px-3 py-2 rounded-lg text-sm font-medium transition-colors">
          About
        </a>
        <div class="w-px h-5 bg-sand-200 dark:bg-sand-700 mx-2"></div>
        <pagefind-modal-trigger compact hide-shortcut class="search-trigger"
          aria-label="Search">
        </pagefind-modal-trigger>

        <!-- GitHub -->
        <a href="https://github.com/riipandi/vitto" target="_blank" rel="noopener noreferrer"
          class="text-sand-500 dark:text-sand-400 hover:text-sand-900 dark:hover:text-white p-2 rounded-lg transition-colors"
          aria-label="GitHub">
          <img src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg" class="w-5 h-5 dark:invert" alt="GitHub">
        </a>

      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-2 md:hidden">
        <button id="mobile-menu-button" type="button"
          class="text-sand-500 hover:text-sand-700 dark:text-sand-400 dark:hover:text-sand-200 focus:outline-none p-2 rounded-lg"
          aria-label="Toggle menu" aria-expanded="false">
          <svg id="menu-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile menu backdrop -->
<div id="mobile-menu-overlay" class="hidden fixed inset-0 z-40 md:hidden bg-sand-900/30 dark:bg-black/50 backdrop-blur-sm"></div>

<!-- Mobile menu panel -->
<div id="mobile-menu" class="hidden fixed top-16 left-0 right-0 bottom-0 z-50 md:hidden">
  <div class="flex flex-col h-full w-full max-w-sm ml-auto bg-sand-50 dark:bg-sand-900 border-l border-sand-200/60 dark:border-sand-800/60 shadow-2xl shadow-sand-900/20 dark:shadow-black/40">

    <!-- Nav links -->
    <nav class="flex-1 overflow-y-auto px-3 py-5 space-y-1.5">
      <a href="/"
        class="{{currentPath === '/' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 font-semibold' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800 hover:text-sand-900 dark:hover:text-white'}} flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Home</span>
      </a>
      <a href="/blog"
        class="{{currentPath?.startsWith('/blog') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 font-semibold' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800 hover:text-sand-900 dark:hover:text-white'}} flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
        <span>Blog</span>
      </a>
      <a href="/docs"
        class="{{currentPath?.startsWith('/docs') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 font-semibold' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800 hover:text-sand-900 dark:hover:text-white'}} flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 19.5"/><path d="M8 2v20"/></svg>
        <span>Docs</span>
      </a>
      <a href="/changelog"
        class="{{currentPath?.startsWith('/changelog') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 font-semibold' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800 hover:text-sand-900 dark:hover:text-white'}} flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        <span>Changelog</span>
      </a>
      <a href="/about"
        class="{{currentPath === '/about' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 font-semibold' : 'text-sand-700 dark:text-sand-300 hover:bg-sand-100 dark:hover:bg-sand-800 hover:text-sand-900 dark:hover:text-white'}} flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
        <span>About</span>
      </a>
    </nav>

    <!-- Search trigger -->
    <div class="px-5 py-4">
      <div class="mobile-search-wrap p-0 rounded-xl bg-sand-100 dark:bg-sand-800 hover:bg-sand-200 dark:hover:bg-sand-700 transition-colors overflow-hidden flex items-center">
        <pagefind-modal-trigger hide-shortcut
          aria-label="Search">
        </pagefind-modal-trigger>
      </div>
    </div>
    <!-- Footer: GitHub -->
    <div class="px-5 py-4 border-t border-sand-200/60 dark:border-sand-800/60">
      <a href="https://github.com/riipandi/vitto" target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 px-4 py-3 rounded-xl text-sm font-medium bg-sand-100 dark:bg-sand-800 text-sand-600 dark:text-sand-400 hover:bg-sand-200 dark:hover:bg-sand-700 hover:text-sand-900 dark:hover:text-white transition-all">
        <img src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg" class="w-4 h-4 dark:invert" alt="">
        <span>View on GitHub</span>
      </a>
    </div>
  </div>
</div>
