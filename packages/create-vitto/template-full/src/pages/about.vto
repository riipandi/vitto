{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'About') }}
{{ setMetadata('description', 'Learn more about this starter project built with Vite.') }}

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-sand-50 to-sand-100/50 dark:from-sand-900 dark:to-sand-900"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-gradient-to-b from-emerald-200/15 via-transparent to-transparent dark:from-emerald-500/8 dark:via-transparent dark:to-transparent rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-3xl mx-auto px-5 sm:px-8 pt-20 pb-16 md:pt-28 md:pb-20 text-center">
    <h1 class="slide-up text-4xl md:text-5xl font-bold tracking-tight text-sand-900 dark:text-white mb-6">
      About This Project
    </h1>
    <p class="slide-up-delay-1 text-lg text-sand-500 dark:text-sand-400 leading-relaxed max-w-2xl mx-auto">
      A modern starter project built with Vite.
      Fast, flexible, and developer-friendly.
    </p>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-emerald-500/20 dark:via-emerald-400/15 to-transparent"></div>
</section>

<!-- Content -->
<section class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="prose prose-lg max-w-none">
      <h2>About</h2>
      <p>
        This project was created to help you get started quickly with a modern toolchain.
        It provides a solid foundation for building static sites, documentation, or blogs.
      </p>
      <p>
        Built on top of <a href="https://vite.dev">Vite</a> and the <a href="https://vento.js.org">Vento</a>
        templating engine, it gives you modern tooling without the overhead.
      </p>

      <h2>Philosophy</h2>
      <ul>
        <li><strong>Simple</strong> — Minimal configuration to get started</li>
        <li><strong>Flexible</strong> — Customize when you need to</li>
        <li><strong>Fast</strong> — Leverages Vite's optimized build pipeline</li>
        <li><strong>Developer-Friendly</strong> — Hot reload, helpful errors, great DX</li>
      </ul>

      <h2>Getting Started</h2>
      <p>
        Clone the repository, install dependencies, and start building.
        Full documentation is available in the docs section.
      </p>

      <h2>License</h2>
      <p>
        This project is MIT licensed. Feel free to use it for any purpose.
        Check the <a href="https://github.com/riipandi/vitto">original repository</a> for
        more information and documentation.
      </p>
    </div>
  </div>
</section>
