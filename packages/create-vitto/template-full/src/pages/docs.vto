{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Documentation') }}
{{ setMetadata('description', 'Documentation and guides for your project.') }}

<div class="max-w-7xl w-full mx-auto px-5 sm:px-8 py-12 md:py-14">
    <div class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-sand-900 dark:text-white mb-4">
        Documentation
      </h1>
      <p class="text-sand-500 dark:text-sand-400 text-lg leading-relaxed">
        Documentation and guides for your project.
      </p>
    </div>

    <!-- Getting Started -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-sand-900 dark:text-white mb-4 pb-2 border-b border-sand-200/60 dark:border-sand-700/40">
        Getting Started
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/docs/getting-started/overview"
          class="group flex items-start gap-3 p-4 rounded-xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-emerald-300/60 dark:hover:border-emerald-500/30 transition-all hover:shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sand-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Overview</h3>
            <p class="text-xs text-sand-400 dark:text-sand-500 mt-0.5">Project overview</p>
          </div>
        </a>
        <a href="/docs/getting-started/quick-start"
          class="group flex items-start gap-3 p-4 rounded-xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-emerald-300/60 dark:hover:border-emerald-500/30 transition-all hover:shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sand-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Quick Start</h3>
            <p class="text-xs text-sand-400 dark:text-sand-500 mt-0.5">Installation and setup</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Core Concepts -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-sand-900 dark:text-white mb-4 pb-2 border-b border-sand-200/60 dark:border-sand-700/40">
        Core Concepts
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/docs/core/templating"
          class="group flex items-start gap-3 p-4 rounded-xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-emerald-300/60 dark:hover:border-emerald-500/30 transition-all hover:shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sand-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Templating</h3>
            <p class="text-xs text-sand-400 dark:text-sand-500 mt-0.5">Vento template engine</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-sand-900 dark:text-white mb-4 pb-2 border-b border-sand-200/60 dark:border-sand-700/40">
        Features
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/docs/features/search"
          class="group flex items-start gap-3 p-4 rounded-xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-emerald-300/60 dark:hover:border-emerald-500/30 transition-all hover:shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sand-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Search</h3>
            <p class="text-xs text-sand-400 dark:text-sand-500 mt-0.5">Full-text search with Pagefind</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Guides -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-sand-900 dark:text-white mb-4 pb-2 border-b border-sand-200/60 dark:border-sand-700/40">
        Guides
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/docs/guides/examples"
          class="group flex items-start gap-3 p-4 rounded-xl bg-white dark:bg-sand-800/50 border border-sand-200/60 dark:border-sand-700/40 hover:border-emerald-300/60 dark:hover:border-emerald-500/30 transition-all hover:shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sand-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Examples</h3>
            <p class="text-xs text-sand-400 dark:text-sand-500 mt-0.5">Real-world examples</p>
          </div>
        </a>
      </div>
    </div>
</div>
