{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'Home') }}

<div class="hero-center">
  <div class="hero-logos">
    <img src="/vite.svg" alt="Vite logo">
    <img src="/favicon.svg" alt="Vento logo">
  </div>
  <div class="hero-content">
    <h1>Welcome to Vitto</h1>
    <p>A minimal static site generator built with Vite and Vento.</p>
    <div class="hero-steps">
      <div class="step">
        <span class="step-number">1</span>
        <p>Edit <code>src/pages/index.vto</code> to get started</p>
      </div>
      <div class="step">
        <span class="step-number">2</span>
        <p>Save and see your changes instantly</p>
      </div>
    </div>
  </div>
</div>
