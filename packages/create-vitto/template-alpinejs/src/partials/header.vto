<header x-data="{ mobileMenuOpen: false }">
  <div class="container">
    <a href="/" class="logo">{{ metadata.siteName }}</a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav">
      <a href="/" class="{{ currentPath === '/' ? 'active' : '' }}">Home</a>
      <a href="/about" class="{{ currentPath === '/about' ? 'active' : '' }}">About</a>
      <a href="/not-found">Not Found</a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      class="mobile-menu-btn"
      @click="mobileMenuOpen = !mobileMenuOpen"
      :aria-expanded="mobileMenuOpen"
      aria-label="Toggle menu"
    >
      <svg x-show="!mobileMenuOpen" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg x-show="mobileMenuOpen" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav
    class="mobile-nav"
    x-show="mobileMenuOpen"
    x-transition:enter="mobile-nav-enter"
    x-transition:enter-start="mobile-nav-enter-start"
    x-transition:enter-end="mobile-nav-enter-end"
    x-transition:leave="mobile-nav-leave"
    x-transition:leave-start="mobile-nav-leave-start"
    x-transition:leave-end="mobile-nav-leave-end"
    @click.away="mobileMenuOpen = false"
  >
    <a href="/" class="{{ currentPath === '/' ? 'active' : '' }}" @click="mobileMenuOpen = false">Home</a>
    <a href="/about" class="{{ currentPath === '/about' ? 'active' : '' }}" @click="mobileMenuOpen = false">About</a>
    <a href="/not-found" @click="mobileMenuOpen = false">Not Found</a>
  </nav>
</header>
