{
    "name": "create-vitto",
    "version": "0.0.0",
    "description": "Command-line utility to scaffold Vite apps using Vitto.",
    "keywords": [
        "cli",
        "command-line",
        "generator",
        "utilities",
        "vento",
        "vite"
    ],
    "homepage": "https://github.com/riipandi/vitto",
    "bugs": {
        "url": "https://github.com/riipandi/vitto/issues"
    },
    "license": "MIT",
    "author": "Aris Ripandi <aris@duck.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/riipandi/vitto",
        "directory": "packages/create-vitto"
    },
    "funding": "https://github.com/riipandi/vitto?sponsor=1",
    "bin": {
        "create-vitto": "./bin/create-vitto.mjs"
    },
    "files": [
        "bin/**/*",
        "dist/**/*",
        "!tests/**/*",
        "!dist/**/*.*.map",
        "!tests/**/*.*.map",
        "package.json",
        "template-*",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "executableFiles": [
            "./bin/create-vitto.mjs"
        ]
    },
    "scripts": {
        "build": "tsdown",
        "dev": "pnpm build &>/dev/null && NODE_ENV=development node ./bin/create-vitto.mjs",
        "publish:dry": "NODE_ENV=production pnpm publish --no-git-checks --dry-run",
        "publish:npm": "NODE_ENV=production pnpm publish --no-git-checks --provenance",
        "cleanup": "pnpm dlx del-cli dist node_modules .turbo",
        "prepublishOnly": "NODE_ENV=production tsdown",
        "lint": "oxlint --fix",
        "check": "oxlint --fix && oxfmt --write",
        "format": "oxfmt --write",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "citty": "^0.2.2",
        "consola": "^3.4.2",
        "cross-spawn": "^7.0.6"
    },
    "devDependencies": {
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^26.1.1",
        "oxfmt": "0.60.0",
        "oxlint": "^1.75.0",
        "tsdown": "^0.22.13",
        "typescript": "^7.0.2",
        "vite": "^8.1.5"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
