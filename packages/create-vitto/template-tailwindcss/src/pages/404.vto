{{ layout "layouts/base.vto" }}

{{ setMetadata('title', 'Page Not Found') }}

<div class="flex-1 flex items-center justify-center overflow-y-auto bg-gray-50 dark:bg-gray-950">
  <div class="text-center py-8 px-4 w-full">
    <div class="max-w-lg mx-auto">
      <h1 class="text-[8rem] font-bold text-gray-900 dark:text-white leading-none mb-4">404</h1>
      <h2 class="text-3xl font-semibold text-gray-900 dark:text-white mb-4">Page Not Found</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Sorry, we couldn't find the page you're looking for.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-block px-6 py-3 bg-blue-600 dark:bg-blue-500 text-white rounded-lg font-medium transition-colors duration-300 hover:bg-blue-700 dark:hover:bg-blue-600 no-underline">
          Go Home
        </a>
        <button onclick="window.history.back()" class="inline-block px-6 py-3 bg-gray-200 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg font-medium transition-colors duration-300 hover:bg-gray-300 dark:hover:bg-gray-700 border-none cursor-pointer">
          Go Back
        </button>
      </div>
    </div>
  </div>
</div>
