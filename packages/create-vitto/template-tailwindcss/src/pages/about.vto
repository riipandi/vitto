{{ layout "layouts/site.vto" }}

{{ setMetadata('title', 'About') }}

<div class="text-center py-8 px-4 w-full max-w-[900px] mx-auto">
  <div class="max-w-full">
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">About This Template</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-12">This is a simple and modern template built with:</p>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-8 mt-8">
      <div class="p-8 rounded-xl bg-white dark:bg-gray-800 transition-all duration-300 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
        <div class="text-5xl mb-4">⚡</div>
        <h3 class="text-2xl mb-2 text-gray-900 dark:text-white">Vite</h3>
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed m-0">Lightning fast build tool with instant HMR</p>
      </div>

      <div class="p-8 rounded-xl bg-white dark:bg-gray-800 transition-all duration-300 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
        <div class="text-5xl mb-4">🌬️</div>
        <h3 class="text-2xl mb-2 text-gray-900 dark:text-white">Vento</h3>
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed m-0">Minimal and powerful template engine</p>
      </div>

      <div class="p-8 rounded-xl bg-white dark:bg-gray-800 transition-all duration-300 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
        <div class="text-5xl mb-4">🎨</div>
        <h3 class="text-2xl mb-2 text-gray-900 dark:text-white">Tailwind CSS</h3>
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed m-0">Utility-first CSS framework for rapid UI development</p>
      </div>
    </div>
  </div>
</div>
